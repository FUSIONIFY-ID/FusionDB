# FusionDB local development
NODE_ENV=development

# Console / API
FUSION_CONSOLE_URL=http://localhost:3000
FUSION_API_URL=http://localhost:4000
API_HOST=0.0.0.0
API_PORT=4000

# Control Plane PostgreSQL
CONTROL_DATABASE_URL=postgresql://fusion_control:fusion_control_local@localhost:5432/fusion_control

# Project PostgreSQL administrator. INTERNAL ONLY.
PROJECT_DB_ADMIN_URL=postgresql://fusion_internal_admin:fusion_project_admin_local@localhost:5433/postgres

# Host/port emitted in customer direct connection URLs.
PROJECT_DB_PUBLIC_HOST=localhost
PROJECT_DB_PUBLIC_PORT=5433

# Management authentication
BETTER_AUTH_SECRET=local-development-only-change-me-please-32chars-minimum
BETTER_AUTH_URL=http://localhost:4000

# 32 zero bytes, local development only. Generate a unique production key.
FUSION_MASTER_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Logging
LOG_LEVEL=debug
