# FusionDB local development
NODE_ENV=development

# Control Plane PostgreSQL
CONTROL_DATABASE_URL=postgresql://fusion_control:fusion_control@localhost:5432/fusion_control

# Project PostgreSQL administrator used ONLY by the local provisioner.
# Never expose this credential to application clients.
PROJECT_DB_ADMIN_URL=postgresql://fusion_internal_admin:change-me@localhost:5433/postgres

# Public endpoints
FUSION_CONSOLE_URL=http://localhost:3000
FUSION_API_URL=http://localhost:4000
FUSION_GATEWAY_URL=http://localhost:4100

# Auth
BETTER_AUTH_SECRET=replace-with-local-random-secret
BETTER_AUTH_URL=http://localhost:4000

# Logging
LOG_LEVEL=debug
